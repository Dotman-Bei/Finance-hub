# FinanceHub — copy to .env and fill in before `docker compose up`.
# Every service reads these; shared/config.py is the single loader.

# ── PostgreSQL (single source of truth) ──────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=financehub
POSTGRES_USER=financehub
POSTGRES_PASSWORD=changeme
DATABASE_URL=postgresql+psycopg2://financehub:changeme@postgres:5432/financehub

# Running a service on the host (see build.md §15) instead of in the network?
# Use the published port: postgresql+psycopg2://financehub:changeme@localhost:5432/financehub

# ── Redis (validation-result cache + dashboard query cache) ──────────────
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# ── Kafka (ingestion backbone) ───────────────────────────────────────────
KAFKA_BROKER=kafka:9092
# From the host, use the external listener: localhost:29092
KAFKA_TOPIC_RAW=raw_transactions

# ── Reconciliation tuning ────────────────────────────────────────────────
# Candidate pairs scoring below this do not persist to matchedrecords (§9).
MATCH_CONFIDENCE_THRESHOLD=0.85
# Resolved-exception count that triggers classifier retraining (§11).
RETRAIN_TRIGGER_COUNT=200

# ── Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET=change-this
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480

# Shared credential POST /auth/token checks before minting a role token.
# This is NOT an identity provider - there is no user store in this system.
# A deployment puts a real IdP in front of the gateway. Leave empty to disable
# token issue entirely.
SERVICE_API_KEY=change-this-too

# Set to false ONLY for local development. Every caller then becomes a
# SYSTEM_ADMINISTRATOR; the gateway logs a warning at startup when it is off.
REQUIRE_AUTH=true

# Where the gateway forwards POST /exceptions/{id}/resolve (Sec. 10 owns it).
EXCEPTION_HANDLER_URL=http://exception_handler:8003

# Browser origins allowed to call the gateway.
CORS_ORIGINS=http://localhost:3000
