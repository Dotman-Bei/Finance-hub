# Leave empty to call the reporting_api same-origin through the dev proxy
# (vite.config.js) or the nginx reverse proxy in the container.
VITE_API_BASE_URL=

# Where the dev proxy forwards /metrics, /exceptions, /reports and /ws.
VITE_PROXY_TARGET=http://localhost:8000

# Override only when the WebSocket lives somewhere other than the page origin.
VITE_WS_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT=12000
