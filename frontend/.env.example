# Leave empty to call the reporting_api same-origin through the dev proxy
# (vite.config.js) or the nginx reverse proxy in the container.
VITE_API_BASE_URL=

# Where the dev proxy forwards /metrics, /exceptions, /reports and /ws.
VITE_PROXY_TARGET=http://localhost:8000

# Override only when the WebSocket lives somewhere other than the page origin.
VITE_WS_URL=

# Request timeout in milliseconds.
VITE_API_TIMEOUT=12000

# Prefills the sign-in card so a demo is one click. Must match SERVICE_API_KEY
# on the reporting gateway.
#
# Every VITE_ variable is compiled into the public JS bundle and is readable by
# anyone with devtools. That is acceptable for a shared demo secret and is not
# a way to ship a real credential: a deployment puts an identity provider in
# front of the gateway and drops /auth/token entirely. Leave this blank to make
# the card ask for the key instead.
VITE_SERVICE_API_KEY=
