# Normalise line endings.
#
# This repo is authored on Windows and built in Linux containers. A Dockerfile,
# shell snippet or entrypoint checked out with CRLF fails inside the image with
# errors that point nowhere useful, so everything text is stored and checked out
# with LF regardless of platform.
* text=auto eol=lf

# Windows-only files keep CRLF.
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf

# Binary: never touch, never diff as text.
*.pkl  binary
*.png  binary
*.jpg  binary
*.pdf  binary
*.ico  binary
*.woff binary
*.woff2 binary

# Generated; collapse in review diffs.
package-lock.json linguist-generated=true -diff
